{:paths ["src"]
 ;; ipns.core (name derivation) stays zero-dep and portable -- these two
 ;; are pulled in ONLY by ipns.head (:clj-only signed head records), same
 ;; git-sha-pin convention kotoba-lang/cacao's deps.edn documents
 ;; (ADR-2607022400). SHAs are each sibling repo's origin/main HEAD as of
 ;; 2026-07-06.
 :deps {io.github.kotoba-lang/ed25519
        {:git/url "https://github.com/kotoba-lang/ed25519.git"
         :git/sha "fdcefb9f1b83461fee54d04b63e374fa301ee847"}
        ;; Renamed upstream: kotoba-lang/dag-cbor is kotoba-lang/org-ietf-cbor.
        ;; The old URL still resolves through GitHub's redirect, which is why
        ;; this went unnoticed; the coordinate now names the repository that
        ;; exists. The sha moves 18 commits, over the change that made `Tagged`
        ;; a defrecord instead of a deftype -- SCI cannot dispatch a custom
        ;; IEquiv/IHash on a deftype, so the old pin cannot load under nbb.
        io.github.kotoba-lang/org-ietf-cbor
        {:git/sha "cf2066f8dfa67a2934365519745231b4f1673a1a"}
        ;; ipns.record needs the protobuf wire format (the IPNS record IS a
        ;; protobuf) and the dag-cbor above (its signed `data` field is CBOR).
        ;; Both are zero-dep .cljc, so ipns.record stays portable; only
        ;; ipns.head remains :clj-only for its JCA Ed25519 path.
        io.github.kotoba-lang/dev-protobuf
        {:git/url "https://github.com/kotoba-lang/dev-protobuf.git"
         :git/sha "3f20b1e1cdbe89750d8afaf24f64777a2f170c3c"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
